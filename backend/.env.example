# Backend environment variables
PORT=3000
# CORS origin to allow requests from frontend (set to frontend origin in production)
CORS_ORIGIN=http://localhost:5173
# Production frontend origin (used by CORS whitelist)
FRONTEND_URL=http://localhost:5173

# Database configuration (MySQL)
# Cách 1: Dùng DATABASE_URL
# DATABASE_URL=mysql://user:password@host:3306/database
# DATABASE_URL=mysql://root:@127.0.0.1:3306/nexgenus

# Cách 2: Dùng các biến riêng lẻ
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=nexgenus

# Auto-run migrations on startup (recommended in production)
AUTO_MIGRATE=true

API_KEY=replace_with_real_api_key
NODE_ENV=development

# Gemini AI (Chatbot)
GEMINI_API_KEY=
# Optional override (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Upload file — Coolify / local disk storage (KHÔNG dùng Firebase)
# URL public của backend, dùng để tạo link file: {BACKEND_URL}/uploads/<filename>
BACKEND_URL=http://localhost:3000
# Thư mục lưu file trên disk (mặc định: backend/public/uploads)
# Trên Coolify nên mount Persistent Volume vào path này
# UPLOAD_DIR=/app/backend/public/uploads
